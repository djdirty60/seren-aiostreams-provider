{
  "metadata": {
    "id": "custom.ultra-dv-fel-remux",
    "name": "Ultra 4K DV FEL Remux",
    "description": "Puts the best on top: 4K BluRay REMUX with Dolby Vision P7 (FEL), IMAX, Atmos/TrueHD and DTS:X. Debrid and Easynews, failover, next-episode precache and Dutch audio/subs preferred. Fake remuxes, upscales, 3D and cam rips removed.",
    "author": "djdirty60",
    "source": "custom",
    "version": "1.3.0",
    "category": "Debrid",
    "tags": [
      "4K",
      "Dolby Vision",
      "Remux"
    ],
    "serviceRequired": true,
    "services": [
      "realdebrid",
      "torbox",
      "premiumize",
      "alldebrid",
      "debridlink",
      "easydebrid",
      "debrider",
      "offcloud",
      "pikpak",
      "easynews"
    ],
    "setToSaveInstallMenu": true,
    "changelog": [
      {
        "date": "2026-11-03",
        "version": "1.3.0",
        "content": "Top remux groups, next-episode precache, failover, 150 Mbps bitrate cap, Dutch preferred, fake remuxes and regrades removed"
      },
      {
        "date": "2026-10-27",
        "version": "1.2.0",
        "content": "Resolution sorts first: 4K always above 1080p"
      },
      {
        "date": "2026-10-25",
        "version": "1.1.0",
        "content": "Easynews Search added"
      },
      {
        "date": "2026-10-25",
        "version": "1.0.0",
        "content": "First version"
      }
    ]
  },
  "config": {
