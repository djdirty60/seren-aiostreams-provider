        "usenet"
      ]
    },
    "excludedStreamExpressions": [
      {
        "expression": "/*Fake 4K REMUX movie (<20 GB)*/ queryType == 'movie' ? size(resolution(quality(streams, 'BluRay REMUX'), '2160p'), 1, '20GB') : []",
        "enabled": true
      },
      {
        "expression": "/*Fake 1080p REMUX movie (<10 GB)*/ queryType == 'movie' ? size(resolution(quality(streams, 'BluRay REMUX'), '1080p'), 1, '10GB') : []",
        "enabled": true
      },
      {
        "expression": "/*Regrades and upscales*/ keyword(streams, 'filename,folderName', 'Regrade', 'Regraded', 'Upscale', 'Upscaled', 'UpRez', 'AI Upscale')",
        "enabled": true
      }
    ],
    "preferredAudioChannels": [
      "7.1",
      "6.1",
      "5.1",
      "2.0",
      "Unknown"
    ],
    "rankedStreamExpressions": [
      {
        "expression": "/*Dolby Vision FEL (P7)*/ keyword(streams, 'filename,folderName', 'FEL', 'P7')",
        "score": 400,
        "enabled": true
      },
      {
        "expression": "/*4K REMUX with Dolby Vision*/ resolution(quality(visualTag(streams, 'DV', 'HDR+DV', 'DV Only'), 'BluRay REMUX'), '2160p')",
        "score": 300,
        "enabled": true
      },
      {
        "expression": "/*Top group 4K REMUX (often FEL)*/ resolution(quality(keyword(streams, 'releaseGroup,filename', 'FraMeSToR', 'BLURANiUM', 'CiNEPHiLES', 'WiLDCAT', 'PiRAMiDHEAD', '3L', 'BMF', 'ZQ', 'ATELiER', 'BiZKiT', 'PmP'), 'BluRay REMUX'), '2160p')",
        "score": 150,
        "enabled": true
      },
      {
        "expression": "/*4K REMUX*/ resolution(quality(streams, 'BluRay REMUX'), '2160p')",
        "score": 200,
        "enabled": true
      },
      {
        "expression": "/*IMAX*/ visualTag(streams, 'IMAX')",
        "score": 80,
        "enabled": true
      },
      {
        "expression": "/*Atmos or DTS:X*/ audioTag(streams, 'Atmos', 'DTS:X')",
        "score": 70,
        "enabled": true
      },
      {
        "expression": "/*Lossless audio (TrueHD / DTS-HD MA)*/ audioTag(streams, 'TrueHD', 'DTS-HD MA', 'PCM', 'FLAC')",
        "score": 50,
        "enabled": true
      },
      {
        "expression": "/*Dolby Vision*/ visualTag(streams, 'DV', 'HDR+DV', 'DV Only')",
        "score": 50,
        "enabled": true
      },
      {
        "expression": "/*HDR10+*/ visualTag(streams, 'HDR10+')",
        "score": 15,
        "enabled": true
      },
      {
        "expression": "/*7.1 channels*/ audioChannels(streams, '7.1')",
        "score": 15,
        "enabled": true
      }
    ],
    "resultLimits": {
      "global": 20,
      "resolution": 10
    },
    "precacheNextEpisode": true,
    "failover": {
      "enabled": true,
      "contentTypes": [
        "debrid",
        "usenet"
      ],
      "allowCrossType": true,
      "maxAttempts": 3
    },
    "bitrate": {
      "useMetadataRuntime": true,
      "global": {
        "movies": [
          0,
          150000000
        ],
        "series": [
          0,
          150000000
        ]
      }
    },
    "preferredSubtitles": [
      "Dutch"
    ]
